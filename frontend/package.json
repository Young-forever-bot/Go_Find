{
  "name": "go-find-ui",
  "version": "1.0.0",
  "description": "Young@Asset Collection 桌面控制台 —— 子域名收集 / 端口开放探测 / 端口服务识别 / WHOIS备案",
  "main": "main.js",
  "scripts": {
    "start": "electron ."
  },
  "author": "Go_Find",
  "license": "MIT",
  "devDependencies": {
    "electron": "^37.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.young.assetcollection",
    "productName": "Young@Asset Collection",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "styles.css"
    ],
    "extraResources": [
      {
        "from": "../bin",
        "to": "bin"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ]
    },
    "portable": {
      "artifactName": "Young@Asset Collection.exe"
    }
  }
}
